{
  "name": "rider-layout",
  "displayName": "Rider Layout for C#",
  "description": "Applies JetBrains Rider-compatible C# file and type layout patterns in VS Code.",
  "version": "0.7.0",
  "publisher": "sam1965",
  "license": "MIT",
  "homepage": "https://atishbazi.tech/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sehathesam/rider-layout-vscode.git"
  },
  "engines": { "vscode": "^1.95.0" },
  "icon": "images/icon.png",
  "categories": ["Programming Languages", "Formatters", "Other"],
  "activationEvents": ["onLanguage:csharp", "onCommand:riderLayout.pickLayoutFile", "onCommand:riderLayout.resetLayout", "onCommand:riderLayout.toggleEnabled", "onCommand:riderLayout.toggleRegions", "onCommand:riderLayout.toggleFormatOnSave", "onCommand:riderLayout.rearrangeAllFiles", "onCommand:riderLayout.addIgnoreFolder"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "riderLayout.pickLayoutFile", "title": "Rider Layout: Select Layout File" },
      { "command": "riderLayout.resetLayout", "title": "Rider Layout: Reset to Default Layout" },
      { "command": "riderLayout.toggleEnabled", "title": "Rider Layout: Toggle Auto-Apply" },
      { "command": "riderLayout.toggleRegions", "title": "Rider Layout: Toggle Region Blocks" },
      { "command": "riderLayout.toggleFormatOnSave", "title": "Rider Layout: Toggle Format on Save" },
      { "command": "riderLayout.rearrangeDocument", "title": "Rider Layout: Rearrange Document" },
      { "command": "riderLayout.rearrangeAllFiles", "title": "Rider Layout: Rearrange All C# Files" },
      { "command": "riderLayout.addIgnoreFolder", "title": "Rider Layout: Add Ignored Folder" },
      { "command": "riderLayout.reload", "title": "Rider Layout: Reload Settings" },
      { "command": "riderLayout.preview", "title": "Rider Layout: Preview Active Layout" }
    ],
    "configuration": {
      "title": "Rider Layout",
      "properties": {
        "riderLayout.enabled": { "type": "boolean", "default": true },
        "riderLayout.autoApplyOnFocus": { "type": "boolean", "default": true, "description": "Automatically apply the active Rider layout whenever a C# file gains focus." },
        "riderLayout.autoDetect": { "type": "boolean", "default": true },
        "riderLayout.formatOnSave": { "type": "boolean", "default": false },
        "riderLayout.cliPath": { "type": "string", "default": "" },
        "riderLayout.ignoreFolders": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["Migrations"],
          "markdownDescription": "Folder names (by name, at any depth) to skip in **Rearrange All C# Files**, **Auto-Apply on Focus**, **Format on Save** and **Rearrange Document**. `Migrations` is included by default; ignored folders from your `.gitignore` are added automatically on activation. Add more with the file picker: [Add Ignored Folder…](command:riderLayout.addIgnoreFolder)"
        },
        "riderLayout.settingsPath": {
          "type": ["string", "null"],
          "default": null,
          "markdownDescription": "Path to the Rider/ReSharper layout file (`.xml` or `.DotSettings`). Leave empty to use the bundled **ideen-layout.xml** default. Open the file browser to store a custom path (saved globally): [Select Layout File…](command:riderLayout.pickLayoutFile). Go back to the bundled default: [Reset to Default](command:riderLayout.resetLayout). You can also type/paste a path directly here."
        },
        "riderLayout.emitRegions": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for emitting section region blocks. Toggle with the 'Rider Layout: Toggle Region Blocks' command without losing your region selection."
        },
        "riderLayout.regions": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "DEPENDENCIES",
            "CONSTANTS",
            "STATIC FIELDS",
            "FIELDS",
            "SERIALIZED FIELDS",
            "CTORS",
            "PUBLIC EVENTS",
            "INTERNAL EVENTS",
            "PROTECTED EVENTS",
            "PRIVATE EVENTS",
            "ENUMS",
            "INTERFACES",
            "PUBLIC PROPERTIES",
            "INTERNAL PROPERTIES",
            "PROTECTED PROPERTIES",
            "PRIVATE PROPERTIES",
            "PUBLIC INDEXERS",
            "INTERNAL INDEXERS",
            "PROTECTED INDEXERS",
            "PRIVATE INDEXERS",
            "INTERFACE IMPLEMENTATIONS",
            "PUBLIC METHODS",
            "INTERNAL METHODS",
            "PROTECTED METHODS",
            "PRIVATE METHODS",
            "UNITY METHODS",
            "RPC METHODS"
          ],
          "description": "Which <Region Name> values from the layout XML to emit as #region blocks. All are enabled by default; deselect entries to omit specific regions from the output."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json && node ./scripts/copy-assets.mjs",
    "watch": "tsc -w -p ./tsconfig.json",
    "package": "npm run compile && node ./scripts/package.mjs",
    "test": "node ./scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.2"
  }
}
