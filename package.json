{
  "name": "rider-layout",
  "displayName": "Rider Layout for C#",
  "description": "Applies JetBrains Rider-compatible C# file and type layout patterns in VS Code.",
  "version": "0.4.0",
  "publisher": "sam1965",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sehathesam/rider-layout-vscode.git"
  },
  "engines": { "vscode": "^1.95.0" },
  "icon": "images/icon.png",
  "categories": ["Programming Languages", "Formatters", "Other"],
  "activationEvents": ["onLanguage:csharp", "onCommand:riderLayout.pickLayoutFile", "onCommand:riderLayout.toggleEnabled", "onCommand:riderLayout.toggleFormatOnSave"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "riderLayout.pickLayoutFile", "title": "Rider Layout: Select Layout File" },
      { "command": "riderLayout.toggleEnabled", "title": "Rider Layout: Toggle Auto-Apply" },
      { "command": "riderLayout.toggleFormatOnSave", "title": "Rider Layout: Toggle Format on Save" },
      { "command": "riderLayout.rearrangeDocument", "title": "Rider Layout: Rearrange Document" },
      { "command": "riderLayout.reload", "title": "Rider Layout: Reload Settings" },
      { "command": "riderLayout.preview", "title": "Rider Layout: Preview Active Layout" }
    ],
    "configuration": {
      "title": "Rider Layout",
      "properties": {
        "riderLayout.enabled": { "type": "boolean", "default": true },
        "riderLayout.autoApplyOnFocus": { "type": "boolean", "default": true, "description": "Automatically apply the active Rider layout whenever a C# file gains focus." },
        "riderLayout.autoDetect": { "type": "boolean", "default": true },
        "riderLayout.formatOnSave": { "type": "boolean", "default": false },
        "riderLayout.cliPath": { "type": "string", "default": "" },
        "riderLayout.settingsPath": { "type": ["string", "null"], "default": null },
        "riderLayout.regions": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Region headers to emit as #region blocks. Leave empty to keep the legacy flat ordering. The names match the <Region Name> values in the layout XML, e.g. [\"DEPENDENCIES\", \"CONSTANTS\", \"SERIALIZED FIELDS\"]."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json && node ./scripts/copy-assets.mjs",
    "watch": "tsc -w -p ./tsconfig.json",
    "package": "npm run compile && npx @vscode/vsce package",
    "test": "node ./scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.2"
  }
}
